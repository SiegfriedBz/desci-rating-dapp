# Shared monorepo env. apps/web/next.config.ts merges this file into
# process.env, so there is no apps/web/.env.local. Never commit .env.
# Full reference: README "Environment".
#
#   uncommented  ->  you must fill it in
#   commented    ->  optional; the value shown is the default already applied


# ── Vercel runtime · set on Production AND Preview ──────────────────────

# Context graph the web catalog reads and the Inngest workers write to.
# A bare name is fine against a local daemon; on Vercel it must be the node's
# full <agent-address>/<name> id, and Production and Preview use different
# graphs (README "Vercel").
DKG_CONTEXT_GRAPH_ID=verisci

# Hosted DKG node. Omit locally to fall back to ~/.dkg; required on Vercel,
# where no ~/.dkg exists. See README "Production setup".
# DKG_API_URL=http://127.0.0.1:9200
# DKG_AUTH_TOKEN=

# Pins PDFs to IPFS.
PINATA_JWT=

# Gateway for reading PDFs back. Avoid ipfs.io (rate limits / SW-only).
# IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# In production this includes the secret path prefix (README "Node host").
# GROBID_URL=http://127.0.0.1:8070

# Every server-side contract read, plus fulfillPhase1.
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/<YOUR_KEY>

# Signs fulfillPhase1; must match on-chain oracleAgent().
# Not the Foundry deployer key, and not a DKG key.
ORACLE_AGENT_PRIVATE_KEY=0x...

# HMAC secret for /api/webhooks/alchemy.
ALCHEMY_BASE_SEPOLIA_WH_SK=

# Gemini, for pdf-to-ka extraction and ka-scorer.
GOOGLE_API_KEY=

# GEMINI_MODEL=gemini-3.5-flash-lite

# Inngest Cloud. Read by the SDK itself, not by @desci/env.
INNGEST_EVENT_KEY=

# Inngest Cloud only — the local Dev Server needs neither.
# INNGEST_SIGNING_KEY=
# INNGEST_API_BASE_URL=http://localhost:8288


# ── Vercel build · inlined into the client bundle ───────────────────────

# Reown AppKit metadata.url; must match the deployed origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# RatingController for THIS environment. ts/deployments.ts records only the
# last deploy; the runtime address always comes from here. Production runs its
# own contract and its own DKG_CONTEXT_GRAPH_ID, so both differ between Vercel
# Production and Preview; local and Preview share the develop contract.
NEXT_PUBLIC_RATING_CONTROLLER_ADDRESS=0xe83d248193e5cdb0db89ecd113feb1c4d0fe9e96

# Reown project id (https://dashboard.reown.com). Without it the app still
# builds, but wallet connect is disabled.
# NEXT_PUBLIC_REOWN_PROJECT_ID=

# Footer contact links. Omit either one to hide it.
# NEXT_PUBLIC_CONTACT_PORTFOLIO_URL=https://www.siegfriedbozza.com/
# NEXT_PUBLIC_CONTACT_LINKEDIN_URL=https://www.linkedin.com/in/siegfriedbozza


# ── Foundry · local only · only to deploy · never set in Vercel ─────────
#
# Read by `forge`, never by TypeScript — deliberately absent from @desci/env
# so the app cannot reach a deployer key. `pnpm contracts:deploy:base-sepolia`
# sources this file with `set -a`.

# --private-key in script/DeployRatingController.s.sol
PRIVATE_KEY=0x...

# vm.envAddress("ORACLE_AGENT") in HelperConfig.s.sol
ORACLE_AGENT=0x...

# ${ETHERSCAN_API_KEY} in foundry.toml
ETHERSCAN_API_KEY=


# ── Local CLI convenience · never needed on Vercel ──────────────────────

# DKG_HOME=~/.dkg
# DKG_API_PORT=9200
# GROBID_TIMEOUT_MS=120000

# Sample KA used by dkg:publish-sample / dkg:fetch-asset.
# DKG_KA_NAME=desci-sample-10

# Fetch resolves the UAL from DKG_KA_NAME when unset.
# DKG_UAL=

# publish-sample only; defaults to urn:uuid:<DKG_KA_NAME>.
# DKG_SUBJECT_URI=

# Input for dkg:publish-pdf (or pass it as argv).
# DKG_PDF_PATH=


# ── Cursor tooling · not an app variable ────────────────────────────────

# Google Stitch MCP (.cursor/mcp.json). Cursor resolves ${env:STITCH_API_KEY}
# from the OS environment, so export it in your shell profile and restart
# Cursor — setting it here has no effect. Key: aistudio.google.com/apikey
# STITCH_API_KEY=
