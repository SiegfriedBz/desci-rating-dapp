# Shared monorepo env (loaded into Next via apps/web/next.config.ts → loadEnvConfig(repo root)).
# You do NOT need a duplicate apps/web/.env.local for these server secrets.

# Optional overrides for the local DKG daemon (defaults: ~/.dkg/auth.token, port 9200)
# DKG_API_URL=http://127.0.0.1:9200
# DKG_API_PORT=9200
# DKG_AUTH_TOKEN=
# DKG_HOME=~/.dkg

DKG_CONTEXT_GRAPH_ID=verisci
# Optional sample KA id for dkg:publish-sample / dkg:fetch-asset (default: desci-sample-10).
# DKG_KA_NAME=desci-sample-10
# DKG_UAL=          # optional; fetch resolves UAL from DKG_KA_NAME when unset
# DKG_SUBJECT_URI=  # publish-sample only; defaults to urn:uuid:<DKG_KA_NAME>
# DKG_PDF_PATH=     # path for pnpm dkg:publish-pdf (or pass as argv)

# GROBID fulltext sidecar (pnpm grobid:up → http://127.0.0.1:8070)
GROBID_URL=http://127.0.0.1:8070
# GROBID_TIMEOUT_MS=120000

# Pinata — pin ingested PDFs to IPFS (required for pnpm dkg:publish-pdf).
# Pinata is only the pin service; the KA stores a content-addressed ipfs:// URI.
PINATA_JWT=
# HTTP gateway for fetchPdfByCid / PDF display (default: https://ipfs.io/ipfs)
# IPFS_GATEWAY_URL=https://ipfs.io/ipfs


# Contracts — Base Sepolia deploy + verify (pnpm contracts:deploy:base-sepolia)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployer/owner wallet (pays deploy gas; can later call setOracleAgent)
PRIVATE_KEY=

# Public address registered on-chain as RatingController.oracleAgent at deploy.
# ONLY this address may call fulfillPhase1 / fulfill later phases.
ORACLE_AGENT=

# Private key of ORACLE_AGENT (same wallet as above — address must match
# RatingController.oracleAgent()). Used by the Inngest worker (Viem) to sign
# fulfillPhase1. NOT the deployer PRIVATE_KEY. NOT a DKG/GatewayNode key.
ORACLE_AGENT_PRIVATE_KEY=

# Basescan / Etherscan API key (V2; same account system as Basescan)
ETHERSCAN_API_KEY=

# Alchemy Notify webhook (HMAC over raw body)
ALCHEMY_BASE_SEPOLIA_WH_SK=

# Gemini agents: pdf-to-ka metadata extract + ka-rigor-scorer (Flash Lite — free tier)
GOOGLE_API_KEY=
# Optional override (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=   # alias for GOOGLE_API_KEY

# Inngest (local: use Inngest Dev Server; cloud: set both keys)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Reown AppKit (apps/web wallet connect) — https://dashboard.reown.com
# Optional: without it the landing still builds; header shows "wallet not configured".
NEXT_PUBLIC_REOWN_PROJECT_ID=
