{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  // Declares the Vercel contract (README "Production setup") so Turbo's
  // platform-env check stays quiet and the values reach `next build`, which
  // validates the @desci/env catalog. NEXT_PUBLIC_* are handled separately by
  // Turbo's Next.js framework inference.
  "globalPassThroughEnv": [
    "DKG_API_URL",
    "DKG_AUTH_TOKEN",
    "DKG_CONTEXT_GRAPH_ID",
    "GROBID_URL",
    "IPFS_GATEWAY_URL",
    "PINATA_JWT",
    "BASE_SEPOLIA_RPC_URL",
    "ORACLE_AGENT_PRIVATE_KEY",
    "ALCHEMY_BASE_SEPOLIA_WH_SK",
    "GOOGLE_API_KEY",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
